{
  "name": "affiliate-backend",
  "version": "1.0.0",
  "description": "Backend API for Affiliate Marketing Platform with order tracking, cashback management, and admin dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "prisma:reset": "prisma migrate reset",
    "setup-admin": "ts-node src/scripts/setup-admin.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "db:backup": "ts-node src/scripts/backup-db.ts",
    "db:restore": "ts-node src/scripts/restore-db.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "affiliate",
    "cashback",
    "express",
    "api",
    "typescript",
    "prisma",
    "jwt",
    "authentication",
    "webhook",
    "shopee",
    "tiktok"
  ],
  "author": "NgDanhThanhTrung",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NgDanhThanhTrung/AFFILIATE.git"
  },
  "homepage": "https://github.com/NgDanhThanhTrung/AFFILIATE#readme",
  "bugs": {
    "url": "https://github.com/NgDanhThanhTrung/AFFILIATE/issues"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "@prisma/client": "^5.16.1",
    "express-rate-limit": "^7.3.1",
    "winston": "^3.13.1",
    "axios": "^1.7.2",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.16.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.5",
    "@types/nanoid": "^3.0.0"
  }
}
