# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# IMPORTANT: 
# 1. Copy this file to .env for local development
# 2. Set these values in Render environment variables for production
# 3. NEVER commit .env file to version control
# 4. Generate strong secrets using: openssl rand -base64 32

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# Neon.tech PostgreSQL connection string
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=your_neon_connection_string_here

# ============================================
# JWT SECRETS (REQUIRED - GENERATE STRONG SECRETS)
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_generated_jwt_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_generated_refresh_secret_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# API CONFIGURATION (REQUIRED)
# ============================================
NODE_ENV=production
API_BASE_URL=https://your-backend.onrender.com
API_PORT=3001

# ============================================
# FRONTEND CONFIGURATION (REQUIRED)
# ============================================
# Your Vercel frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# ============================================
# WEBHOOK SECRETS (REQUIRED - FROM PLATFORMS)
# ============================================
# Get these from your affiliate platform dashboards
SHOPEE_WEBHOOK_SECRET=your_shopee_webhook_secret_from_partner_center
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret_from_seller_center

# ============================================
# ADMIN CONFIGURATION (REQUIRED)
# ============================================
# Super admin phone number for initial setup
SUPER_ADMIN_PHONE_NUMBER=your_phone_number
# Default password for super admin (CHANGE IMMEDIATELY AFTER SETUP)
SUPER_ADMIN_DEFAULT_PASSWORD=secure_password_change_immediately

# ============================================
# AFFILIATE CONFIGURATION (OPTIONAL)
# ============================================
SHOPEE_COMMISSION_RATE=5.0
TIKTOK_COMMISSION_RATE=4.5

# ============================================
# WITHDRAWAL CONFIGURATION (OPTIONAL)
# ============================================
MIN_WITHDRAWAL_AMOUNT=50000
MAX_WITHDRAWAL_AMOUNT=10000000
WITHDRAWAL_FEE_PERCENT=0
WITHDRAWAL_PROCESSING_HOURS=24

# ============================================
# RATE LIMITING (OPTIONAL)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING (OPTIONAL)
# ============================================
LOG_LEVEL=info
