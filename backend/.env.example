# ============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================
# SECURITY WARNING: This is for development only
# For production, use .env.production.template and set values in Render
# NEVER commit .env file to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For development, use local PostgreSQL or Neon.dev
DATABASE_URL="postgresql://affiliate_user:affiliate_password@localhost:5432/affiliate_db"

# ============================================
# JWT CONFIGURATION (GENERATE STRONG SECRETS)
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET="dev_jwt_secret_change_in_production_minimum_32_chars"
JWT_REFRESH_SECRET="dev_refresh_secret_change_in_production_minimum_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# API CONFIGURATION
# ============================================
NODE_ENV="development"
API_BASE_URL="http://localhost:3001"
API_PORT=3001

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL="http://localhost:3000"

# ============================================
# WEBHOOK SECRETS (USE REAL SECRETS IN PRODUCTION)
# ============================================
SHOPEE_WEBHOOK_SECRET="dev_shopee_secret"
TIKTOK_WEBHOOK_SECRET="dev_tiktok_secret"

# ============================================
# ADMIN CONFIGURATION
# ============================================
SUPER_ADMIN_PHONE_NUMBER="0987654321"
SUPER_ADMIN_DEFAULT_PASSWORD="admin123456"

# ============================================
# AFFILIATE CONFIGURATION
# ============================================
SHOPEE_COMMISSION_RATE=5.0
TIKTOK_COMMISSION_RATE=4.5

# ============================================
# WITHDRAWAL CONFIGURATION
# ============================================
MIN_WITHDRAWAL_AMOUNT=50000
MAX_WITHDRAWAL_AMOUNT=10000000
WITHDRAWAL_FEE_PERCENT=0
WITHDRAWAL_PROCESSING_HOURS=24